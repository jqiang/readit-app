# ── Client (VITE_*, bundled into the app — not secrets by design) ──────────

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins must include the dev server origin (e.g. http://localhost:5173)
# Authorized redirect URIs must include http://localhost:5173/ and the deployed URL
# (e.g. https://your-app.vercel.app/), each with a trailing slash.
# Copy this file to .env.local and fill in your client ID. .env.local is gitignored (matches *.local).
VITE_GOOGLE_CLIENT_ID=

# Google Cloud Console > APIs & Services > Credentials > API key
# Used by the Google Drive Picker (in addition to the OAuth client above).
VITE_GOOGLE_API_KEY=

# Google Cloud Console > home page "Project number" (NOT the project ID).
# Passed to the Picker via setAppId, required for it to reliably list/grant
# access to files when the OAuth scope is restricted to drive.file.
VITE_GOOGLE_PROJECT_NUMBER=

# Anthropic Console (console.anthropic.com) > Settings > API Keys.
# OPTIONAL, dev-only convenience: lets `npm run dev` call the Claude API
# directly from the browser for /import, skipping the /api/extract-text
# proxy. Leave unset to always go through the proxy instead (the production
# path) — e.g. when testing with `npx vercel dev`. Never set this in
# Vercel/production, it would ship the key to every visitor.
VITE_ANTHROPIC_API_KEY=

# ── Server-only (no VITE_ prefix — never bundled into the client) ──────────
# For local testing with `npx vercel dev`, put these here too.
# For production, set these in the Vercel project's Environment Variables.

# Google Cloud Console > APIs & Services > Credentials > the OAuth client above > "Client secret".
# Used by api/google-token.ts to exchange authorization codes and refresh tokens.
GOOGLE_CLIENT_SECRET=

# Anthropic Console (console.anthropic.com) > Settings > API Keys.
# Used by api/extract-text.ts to call the Claude API on behalf of the allowed user.
ANTHROPIC_API_KEY=

# The single Google account email allowed to use this app's backend
# (case-insensitive). api/extract-text.ts and api/google-token.ts both reject
# any other signed-in Google account, and fail closed (500) if this is unset.
ALLOWED_EMAIL=
